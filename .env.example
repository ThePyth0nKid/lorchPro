# Database
POSTGRES_DB=lorchpro
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://admin:your_secure_password_here@db:5432/lorchpro

# Redis
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4o
AZURE_OPENAI_DEPLOYMENT_WHISPER=whisper-1
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4-vision
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
